# Public site URL, used for absolute Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://clickmed.example

# Where "Posez-nous votre question" submissions are delivered (server side only).
# Any endpoint accepting a JSON POST: your API, a CRM webhook, an automation tool.
# Payload: { name, phone, email, question, intent, intentLabel, source, submittedAt }
# Leave empty and the form reports that sending is not enabled (nothing is faked).
QUESTION_WEBHOOK_URL=
